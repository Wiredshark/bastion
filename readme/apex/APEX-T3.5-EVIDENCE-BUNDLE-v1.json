  "open_cases": [
    {
      "id": "CMD-055",
      "reason": "the outbox has no reconnect handling yet \u2014 a boot change should drop pending commands, and nothing enforces that"
    },
    {
      "id": "CMD-056",
      "reason": "same missing reconnect handling for a SessionId change"
    },
    {
      "id": "CMD-061",
      "reason": "same-session reconnect must preserve the pending command; the outbox does not model reconnect at all yet"
    },
    {
      "id": "CMD-062",
      "reason": "an explicit logout should clear the outbox, which needs the same missing reconnect/lifecycle seam"
    },
    {
      "id": "CMD-067",
      "reason": "client-side durable retry state across a process restart is not built; the outbox is in-memory"
    },
    {
      "id": "CMD-084",
      "reason": "session closure should drop the journal; nothing yet owns that lifecycle on the server side"
    },
    {
      "id": "CMD-116",
      "reason": "ordering the async terminal against the persistence response needs the live character-worker wiring, which is a later live-path row"
    },
    {
      "id": "CMD-125",
      "reason": "the real SQLite migration and its uniqueness constraint are a later live-path row; the reference store fixes what that migration must guarantee, and claims nothing about the schema itself"
    },
    {
      "id": "CMD-136",
      "reason": "results do not carry a SnapshotEpoch yet; the T3.3 causality field is still dormant, so there is nothing to check staleness against"
    },
    {
      "id": "CMD-152",
      "reason": "a restart cannot currently distinguish failed-before-effect from unknown; that needs the durable row to be consulted on boot, which is the live wiring row CMD-125 also waits on"
    }
  ],
