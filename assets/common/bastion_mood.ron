// bastion (B7-0, row 44): the needs/mood tuning
// (common/src/bastion.rs::MoodConfig). Decay drains a meter per
// GAME-SECOND toward 0.0 (hunger ~42 game-min full-to-empty at 0.0004);
// a need penalizes mood only BELOW its comfort band; weights are
// NEGATIVE (a shortfall subtracts from the base). The thought table is
// a SEPARATE server-side asset (bastion_thoughts.ron) — its keys are
// rtsim's ChronicleKind, which this crate layer cannot see.
(
    mood_base: 0.6,
    // interrupt = the preemption threshold (B7-2): below it the need
    // drops work and self-assigns its need-job; recreation never
    // preempts (interrupt 0 — mood-only meter per the B7 ruling).
    hunger: (decay_per_sec: 0.0004, comfort: 0.5, weight: -0.5, interrupt: 0.2),
    rest: (decay_per_sec: 0.0003, comfort: 0.5, weight: -0.4, interrupt: 0.2),
    recreation: (decay_per_sec: 0.0002, comfort: 0.4, weight: -0.15, interrupt: 0.0),
    // The BREAKDOWN staircase (B7-3): mood sustained below break_minor
    // for break_sustain_secs game-seconds rolls break_chance per
    // arbitration pass; a hit despawns the colonist's will for
    // despond_secs (a Despond self-job at own feet — blocks all claims).
    break_minor: 0.25,
    break_sustain_secs: 30.0,
    break_chance: 0.15,
    despond_secs: 60.0,
)
